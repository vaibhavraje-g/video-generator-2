# deploy/Dockerfile.worker
# Multi-stage lightweight container for on-demand FFmpeg video rendering
FROM python:3.11-slim

# Install system dependencies: FFmpeg, ImageMagick, libsndfile, fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    imagemagick \
    libsndfile1 \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Fix ImageMagick policy to allow TextClips in MoviePy
RUN sed -i 's/rights="none" pattern="@\*"/rights="read|write" pattern="@\*"/' /etc/ImageMagick-6/policy.xml || true

WORKDIR /app

# Install Python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY backend /app/backend

WORKDIR /app/backend

# Set environment
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

# Entrypoint runs the standalone worker script and terminates immediately on completion
ENTRYPOINT ["python", "-m", "app.core.cloud.worker"]
